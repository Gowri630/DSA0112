#include <iostream>
using namespace std;

int main() {
    char ch;

    cout << "Enter the word: ";
    cin >> ch;

    if (ch == 'a' || ch == 'e' || ch == 'i' ||
        ch == 'o' || ch == 'u' ||
        ch == 'A' || ch == 'E' || ch == 'I' ||
        ch == 'O' || ch == 'U') {
        cout << "It is vowel";
    }
    else {
        cout << "It is consonant";
    }

    return 0;
}
